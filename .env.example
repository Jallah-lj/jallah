# PostgreSQL production database.
# Optional today: the API persists through the JSON repository in server/src/store.ts.
# When DATABASE_URL is unset, `npm run db:migrate` skips migrations instead of failing the build.
DATABASE_URL="postgresql://portfolio:password@localhost:5432/portfolio?schema=public"
# Set to "true" once the API reads from PostgreSQL, so migration failures fail the deploy.
DB_MIGRATE_STRICT="false"
JWT_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:4000"
PORT=4000
UPLOAD_DIR="uploads"
DATA_FILE="data/database.json"
NODE_ENV="development"
# STORAGE_DRIVER=local | s3 (adapter extension point)
STORAGE_DRIVER="local"
