generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
}
enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities ActivityLog[]
}
model Profile {
  id String @id @default(uuid())
  name String
  title String
  intro String @db.Text
  bio String @db.Text
  location String?
  email String
  phone String?
  avatarId String?
  avatar Media? @relation("ProfileAvatar",fields:[avatarId],references:[id],onDelete:SetNull)
  socials Json @default("{}")
  years Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SiteSettings {
  id String @id @default(uuid())
  siteTitle String
  metaDescription String?
  keywords String[]
  sectionTitles Json
  navigationLabel Json?
  footerText String?
  seo Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ThemeSettings {
  id String @id @default(uuid())
  mode String @default("system")
  primary String
  secondary String
  accent String
  background String
  surface String
  text String
  muted String
  border String
  radius Int @default(16)
  fontScale Float @default(1)
  typography Json @default("{}")
  layout Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model NavigationItem {
  id String @id @default(uuid())
  label String
  url String
  enabled Boolean @default(true)
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([enabled,order])
}
model Project {
  id String @id @default(uuid())
  name String
  slug String @unique
  shortDescription String
  fullDescription String @db.Text
  category String?
  technologies String[]
  githubUrl String?
  liveUrl String?
  client String?
  role String?
  features String[]
  challenges String?
  solutions String?
  results String?
  startDate DateTime?
  completionDate DateTime?
  featuredImageId String?
  featuredImage Media? @relation("ProjectFeatured",fields:[featuredImageId],references:[id],onDelete:SetNull)
  images ProjectImage[]
  published Boolean @default(false)
  featured Boolean @default(false)
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published,featured,order])
  @@index([category])
}
model ProjectImage {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  mediaId String
  media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade)
  caption String?
  order Int @default(0)
  createdAt DateTime @default(now())
  @@unique([projectId,mediaId])
  @@index([projectId,order])
}
model SkillCategory {
  id String @id @default(uuid())
  name String @unique
  order Int @default(0)
  skills Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Skill {
  id String @id @default(uuid())
  name String
  categoryId String
  category SkillCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
  description String?
  icon String?
  proficiency Int @default(80)
  years Float?
  order Int @default(0)
  visible Boolean @default(true)
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId,visible,order])
}
model Experience {
  id String @id @default(uuid())
  title String
  company String
  companyLogoId String?
  companyLogo Media? @relation("CompanyLogo",fields:[companyLogoId],references:[id],onDelete:SetNull)
  location String?
  employmentType String?
  startDate DateTime
  endDate DateTime?
  current Boolean @default(false)
  description String @db.Text
  responsibilities String[]
  technologies String[]
  order Int @default(0)
  visible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([visible,order])
}
model Education {
  id String @id @default(uuid())
  institution String
  degree String
  field String?
  startDate DateTime
  endDate DateTime?
  description String?
  logoId String?
  logo Media? @relation("EducationLogo",fields:[logoId],references:[id],onDelete:SetNull)
  certificateUrl String?
  order Int @default(0)
  visible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Certification {
  id String @id @default(uuid())
  name String
  organization String
  imageId String?
  image Media? @relation("CertificationImage",fields:[imageId],references:[id],onDelete:SetNull)
  credentialId String?
  credentialUrl String?
  issueDate DateTime
  expirationDate DateTime?
  neverExpires Boolean @default(false)
  description String?
  order Int @default(0)
  visible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Service {
  id String @id @default(uuid())
  title String
  description String
  icon String?
  features String[]
  price String?
  order Int @default(0)
  visible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Testimonial {
  id String @id @default(uuid())
  name String
  position String?
  company String?
  imageId String?
  image Media? @relation("TestimonialImage",fields:[imageId],references:[id],onDelete:SetNull)
  testimonial String @db.Text
  rating Int @default(5)
  order Int @default(0)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model BlogCategory {
  id String @id @default(uuid())
  name String
  slug String @unique
  posts BlogPost[]
  createdAt DateTime @default(now())
}
model BlogTag {
  id String @id @default(uuid())
  name String
  slug String @unique
  posts BlogPost[]
  createdAt DateTime @default(now())
}
model BlogPost {
  id String @id @default(uuid())
  title String
  slug String @unique
  excerpt String?
  content String @db.Text
  status PublishStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  featuredImageId String?
  featuredImage Media? @relation("BlogFeatured",fields:[featuredImageId],references:[id],onDelete:SetNull)
  categoryId String?
  category BlogCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
  tags BlogTag[]
  seo Json @default("{}")
  authorId String?
  readingTime Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,publishedAt])
}
model Media {
  id String @id @default(uuid())
  name String
  fileName String @unique
  mimeType String
  size Int
  url String
  storageKey String?
  width Int?
  height Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectFeatured Project[] @relation("ProjectFeatured")
  projectImages ProjectImage[]
  profileAvatar Profile[] @relation("ProfileAvatar")
  companyLogos Experience[] @relation("CompanyLogo")
  educationLogos Education[] @relation("EducationLogo")
  certificationImages Certification[] @relation("CertificationImage")
  testimonialImages Testimonial[] @relation("TestimonialImage")
  blogFeatured BlogPost[] @relation("BlogFeatured")
  resumes Resume[]
}
model Resume {
  id String @id @default(uuid())
  name String
  mediaId String
  media Media @relation(fields:[mediaId],references:[id],onDelete:Cascade)
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active])
}
model ContactMessage {
  id String @id @default(uuid())
  name String
  email String
  subject String
  message String @db.Text
  read Boolean @default(false)
  ipHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([read,createdAt])
}
model ActivityLog {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  action String
  entity String?
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
